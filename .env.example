# Copie este arquivo para .env e preencha com suas chaves.
# O .env NÃO vai para o Git (já está no .gitignore).

# Chave da API AbacatePay — dashboard app.abacatepay.com > Integração > Criar Chave
# Permissões mínimas: CHECKOUT:CREATE e CHECKOUT:READ
# Chave de Dev mode = transações simuladas; Produção = PIX real
ABACATEPAY_API_KEY=

# Opcionais (webhook, usado quando o sistema estiver em URL pública):
# Secret definido ao cadastrar o webhook no dashboard
ABACATEPAY_WEBHOOK_SECRET=
# Chave pública usada na validação HMAC do header x-webhook-signature
ABACATEPAY_PUBLIC_KEY=
